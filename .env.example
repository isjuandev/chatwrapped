# Copia este archivo como .env solo para levantar el compose en local.
# En Coolify estas variables van en la configuración del recurso (Environment Variables).

# --- Umami / Postgres (docker-compose) ---
# Genera cada secreto con: openssl rand -hex 32
# POSTGRES_PASSWORD debe ser hexadecimal: se usa dentro de DATABASE_URL.
POSTGRES_PASSWORD=
APP_SECRET=
TWO_FACTOR_ENCRYPTION_KEY=

# --- Sitio (build-time) ---
# Panel de Umami > Websites > tu sitio > Website ID.
# Sin valor la app compila y funciona, pero sin analítica.
VITE_UMAMI_WEBSITE_ID=

# Tema visual de la app y de las tarjetas (se aplica al compilar: cambiarlo requiere redeploy).
#   original          lima y coral, tarjetas de color (diseño original)
#   original-oscuro   lima y coral, tarjetas oscuras
#   atardecer         mango y rosado sobre morado, tarjetas de color
#   atardecer-oscuro  mango y rosado sobre morado, tarjetas oscuras (por defecto)
#   tropico           menta y mandarina sobre verde selva, tarjetas de color
#   tropico-oscuro    menta y mandarina sobre verde selva, tarjetas oscuras
#   cafe              amarillo y rosa sobre café tostado, tarjetas de color
#   cafe-oscuro       amarillo y rosa sobre café tostado, tarjetas oscuras
VITE_THEME=atardecer-oscuro

# --- Coolify (opcional) ---
# Dominio público del panel de Umami, p. ej. https://stats.wrapped.isjuandev.com
# SERVICE_FQDN_UMAMI_3000=
